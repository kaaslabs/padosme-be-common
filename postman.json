        {
          "name": "Search",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/search",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"biryani near me\",\n  \"lat\": 12.9716,\n  \"lon\": 77.5946,\n  \"radius_km\": 1.0,\n  \"push_level\": 0,\n  \"entity_type\": \"shop\"\n}" },
            "description": "push_level: 0=1KM, 1=5KM, 2=25KM, 3=PAN INDIA"
          }
        },
        { "name": "Create Search Context", "request": { "method": "POST", "url": "{{base_url}}/search/context", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"query\": \"electronics\",\n  \"lat\": 12.97,\n  \"lon\": 77.59\n}" } } },
        { "name": "Get Search Context", "request": { "method": "GET", "url": "{{base_url}}/search/context/:id" } },
        { "name": "Update Search Context", "request": { "method": "PUT", "url": "{{base_url}}/search/context/:id", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"push_level\": 1\n}" } } },
        { "name": "Delete Search Context", "request": { "method": "DELETE", "url": "{{base_url}}/search/context/:id" } },
        {
          "name": "WebSocket Search",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/ws/search?token={{ws_token}}",
            "description": "WebSocket endpoint for real-time streaming search.\n\nConnect via ws:// or wss:// protocol.\nAuth: JWT token passed as query parameter.\n\nSend JSON messages:\n{\n  \"query\": \"restaurants\",\n  \"lat\": 12.97,\n  \"lon\": 77.59,\n  \"radius_km\": 5.0,\n  \"push_level\": 1\n}\n\nReceives streaming RankedSeller results."
          }
        }
      ]
    },
    {
      "name": "Discovery Service",
      "description": "padosme-discovery-service — Geo-spatial seller discovery",
