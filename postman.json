    {
      "name": "Search API",
      "description": "padosme-search-api — Semantic search with geo-radius and WebSocket streaming",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{base_url}}/health", "auth": { "type": "noauth" } } },
        { "name": "Ready", "request": { "method": "GET", "url": "{{base_url}}/ready", "auth": { "type": "noauth" } } },
