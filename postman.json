{
  "info": {
    "name": "Padosme Platform API",
    "description": "Complete API collection for all Padosme microservices.\n\nVariables:\n- {{base_url}} — API gateway or direct service URL\n- {{jwt_token}} — Bearer token from /auth/verify-otp\n- {{service_token}} — X-Service-Token for service-to-service\n- {{admin_key}} — X-Api-Key for admin config ops\n- {{ws_token}} — WebSocket token from /auth/verify-otp response",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "jwt_token", "value": "" },
    { "key": "service_token", "value": "" },
    { "key": "admin_key", "value": "" },
    { "key": "ws_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth Service",
      "description": "padosme-auth-service — OTP login, JWT tokens, device management",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{base_url}}/health", "auth": { "type": "noauth" } }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/send-otp",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+919876543210\"\n}" }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/verify-otp",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+919876543210\",\n  \"otp\": \"123456\",\n  \"device_id\": \"device-uuid\"\n}" }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/refresh-token",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"...\"\n}" }
          }
        },
        {
          "name": "Validate WS Token (S2S)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/validate-ws-token",
            "header": [
              { "key": "X-Service-Token", "value": "{{service_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{ws_token}}\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{base_url}}/auth/logout" }
        },
        {
          "name": "Purchase Alternate ID",
          "request": { "method": "POST", "url": "{{base_url}}/auth/alternate-id/purchase" }
        },
        {
          "name": "Get Alternate ID",
          "request": { "method": "GET", "url": "{{base_url}}/auth/alternate-id" }
        },
        {
          "name": "Delete Alternate ID",
          "request": { "method": "DELETE", "url": "{{base_url}}/auth/alternate-id" }
        },
        {
          "name": "List Devices",
          "request": { "method": "GET", "url": "{{base_url}}/auth/devices" }
        },
        {
          "name": "Remove Device",
          "request": { "method": "DELETE", "url": "{{base_url}}/auth/devices/:device_id" }
        },
        {
          "name": "Update Push Token",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/auth/devices/:device_id/push-token",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"push_token\": \"fcm-token-here\"\n}" }
          }
        },
        {
          "name": "[Admin] Get User",
          "request": { "method": "GET", "url": "{{base_url}}/admin/users/:user_id" }
        },
        {
          "name": "[Admin] Change User Type",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/admin/users/:user_id/type",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"user_type\": \"seller\"\n}" }
          }
        },
        {
          "name": "[Admin] Revoke All Tokens",
          "request": { "method": "POST", "url": "{{base_url}}/admin/users/:user_id/revoke-all" }
        }
      ]
    },
