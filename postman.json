        { "name": "[Admin] Approve Synonyms", "request": { "method": "POST", "url": "{{base_url}}/admin/synonyms/approve", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"synonym_ids\": [\"uuid1\"]\n}" } } },
        { "name": "[Admin] Reject Terms", "request": { "method": "POST", "url": "{{base_url}}/admin/terms/reject" } },
        { "name": "[Admin] Reject Synonyms", "request": { "method": "POST", "url": "{{base_url}}/admin/synonyms/reject" } }
      ]
    }
  ]
}
