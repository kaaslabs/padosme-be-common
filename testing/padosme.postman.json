              "raw": "{\n  \"title\": \"Grand Opening Sale!\",\n  \"content\": \"50% off on all electronics this weekend. Visit us today!\",\n  \"post_type\": \"promotion\"\n}"
            },
            "url": "{{channel_base_url}}/channel/post"
          }
        },
        {
          "name": "Subscribe to Channel",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-ID", "value": "{{user_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seller_id\": \"{{seller_id}}\"\n}"
            },
            "url": "{{channel_base_url}}/channel/subscribe"
          }
        },
        {
          "name": "Get User Feed",
          "request": {
            "method": "GET",
            "url": "{{channel_base_url}}/channel/feed/{{user_id}}"
          }
        },
        {
          "name": "Unsubscribe from Channel",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-ID", "value": "{{user_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seller_id\": \"{{seller_id}}\"\n}"
            },
            "url": "{{channel_base_url}}/channel/unsubscribe"
          }
        },
        {
          "name": "Flag Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-ID", "value": "{{user_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"post_id\": \"replace-with-post-id\",\n  \"reason\": \"Inappropriate content\"\n}"
            },
            "url": "{{channel_base_url}}/channel/post/flag"
          }
        },
        {
          "name": "Get Flagged Posts (Admin)",
          "request": {
            "method": "GET",
            "url": "{{channel_base_url}}/channel/post/flagged"
          }
        }
      ]
    },
    {
      "name": "8. Rating",
      "item": [
        {
          "name": "Submit Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('review_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seller_id\": \"{{seller_id}}\",\n  \"rating\": 4,\n  \"review_text\": \"Great products and fast service. Highly recommended!\"\n}"
            },
            "url": "{{rating_base_url}}/rating"
          }
        },
        {
          "name": "Get Seller Ratings",
          "request": {
            "method": "GET",
            "url": "{{rating_base_url}}/rating/seller/{{seller_id}}"
          }
        },
        {
          "name": "Update Review",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"review_text\": \"Updated: Excellent products and amazing service!\"\n}"
            },
            "url": "{{rating_base_url}}/rating/{{review_id}}"
          }
        },
        {
          "name": "Flag Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"review_id\": \"{{review_id}}\",\n  \"reason\": \"Fake review\"\n}"
            },
            "url": "{{rating_base_url}}/rating/flag"
          }
        },
        {
          "name": "Delete Review",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{rating_base_url}}/rating/{{review_id}}"
          }
        }
      ]
    },
    {
      "name": "9. SMS (Test)",
      "item": [
        {
          "name": "Send Test SMS",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone_number}}\",\n  \"message\": \"Test message from Postman\"\n}"
            },
            "url": "{{sms_base_url}}/test/sms"
          }
        }
      ]
    },
