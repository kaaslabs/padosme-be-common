{
  "info": {
    "name": "Padosme Auth + User Profile + Seller",
    "description": "End-to-end collection for padosme-auth-service, padosme-user-profile-service, and padosme-seller-service. Configure phone_number and otp before verify-otp.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "7f5e7c75-cf9b-4d46-aa13-1c86b9a51f31"
  },
  "variable": [
    { "key": "auth_base_url", "value": "http://localhost:8080" },
    { "key": "user_profile_base_url", "value": "http://localhost:8081" },
    { "key": "seller_base_url", "value": "http://localhost:8082" },

    { "key": "phone_number", "value": "9876543210" },
    { "key": "country_code", "value": "+91" },
    { "key": "otp", "value": "123456" },

    { "key": "request_id", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "token_type", "value": "Bearer" },
    { "key": "user_id", "value": "" },
    { "key": "public_user_id", "value": "" },

    { "key": "device_id", "value": "postman-device-001" },
    { "key": "device_name", "value": "Postman Runner" },
    { "key": "platform", "value": "android" },
    { "key": "os_version", "value": "14" },
    { "key": "app_version", "value": "1.0.0" },

    { "key": "profile_id", "value": "" },
    { "key": "public_profile_id", "value": "" },
    { "key": "profile_name", "value": "Postman Test User" },
    { "key": "profile_city", "value": "Bengaluru" },
    { "key": "profile_state", "value": "Karnataka" },
    { "key": "profile_pincode", "value": "560001" },
    { "key": "language_preference", "value": "en" },

    { "key": "alternate_user_id", "value": "postman_alt_001" },

    { "key": "aadhar_number", "value": "123412341234" },
    { "key": "aadhar_otp", "value": "123456" },
    { "key": "kyc_transaction_id", "value": "" },

    { "key": "seller_business_name", "value": "Postman Test Store" },
    { "key": "seller_business_type", "value": "retail" },
    { "key": "seller_business_category", "value": "electronics" },
    { "key": "seller_gst_number", "value": "22ABCDE1234A1Z5" },
    { "key": "seller_pan_number", "value": "ABCDE1234F" },
    { "key": "seller_package_type", "value": "S" }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Auth Health",
          "request": {
            "method": "GET",
            "url": "{{auth_base_url}}/health"
          }
        },
        {
          "name": "User Profile Health",
          "request": {
            "method": "GET",
            "url": "{{user_profile_base_url}}/health"
          }
        },
        {
          "name": "User Profile Ready",
          "request": {
            "method": "GET",
            "url": "{{user_profile_base_url}}/ready"
          }
        },
        {
          "name": "User Profile Live",
          "request": {
            "method": "GET",
            "url": "{{user_profile_base_url}}/live"
          }
        },
        {
          "name": "Seller Health",
          "request": {
            "method": "GET",
            "url": "{{seller_base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "if (json && json.request_id) {",
                  "  pm.collectionVariables.set('request_id', json.request_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile_number\": \"{{phone_number}}\",\n  \"country_code\": \"{{country_code}}\"\n}"
            },
            "url": "{{auth_base_url}}/auth/send-otp"
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "if (json && json.access_token) pm.collectionVariables.set('access_token', json.access_token);",
                  "if (json && json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "if (json && json.token_type) pm.collectionVariables.set('token_type', json.token_type);",
                  "if (json && json.user && json.user.user_id) pm.collectionVariables.set('user_id', json.user.user_id);",
                  "if (json && json.user && json.user.public_user_id) pm.collectionVariables.set('public_user_id', json.user.public_user_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile_number\": \"{{phone_number}}\",\n  \"country_code\": \"{{country_code}}\",\n  \"otp\": \"{{otp}}\",\n  \"request_id\": \"{{request_id}}\",\n  \"device_info\": {\n    \"device_id\": \"{{device_id}}\",\n    \"device_name\": \"{{device_name}}\",\n    \"platform\": \"{{platform}}\",\n    \"os_version\": \"{{os_version}}\",\n    \"app_version\": \"{{app_version}}\"\n  }\n}"
            },
            "url": "{{auth_base_url}}/auth/verify-otp"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "if (json && json.access_token) pm.collectionVariables.set('access_token', json.access_token);",
                  "if (json && json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{auth_base_url}}/auth/refresh-token"
          }
        },
        {
          "name": "Purchase Alternate ID",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alternate_user_id\": \"{{alternate_user_id}}\"\n}"
            },
            "url": "{{auth_base_url}}/auth/alternate-id/purchase"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\",\n  \"logout_all_devices\": false\n}"
            },
            "url": "{{auth_base_url}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "2. User Profile",
      "item": [
        {
          "name": "Create Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "if (json && json.profile && json.profile.profile_id) {",
                  "  pm.collectionVariables.set('profile_id', json.profile.profile_id);",
                  "  pm.collectionVariables.set('public_profile_id', json.profile.profile_id);",
                  "}",
                  "if (json && json.profile && json.profile.public_user_id) {",
                  "  pm.collectionVariables.set('public_user_id', json.profile.public_user_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{profile_name}}\",\n  \"address\": {\n    \"line1\": \"123 MG Road\",\n    \"line2\": \"Near City Mall\",\n    \"city\": \"{{profile_city}}\",\n    \"state\": \"{{profile_state}}\",\n    \"pincode\": \"{{profile_pincode}}\"\n  },\n  \"language_preference\": \"{{language_preference}}\"\n}"
            },
            "url": "{{user_profile_base_url}}/v1/api/user/profile"
          }
        },
        {
          "name": "Get Own Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "if (json && json.profile && json.profile.profile_id) {",
                  "  pm.collectionVariables.set('profile_id', json.profile.profile_id);",
                  "  pm.collectionVariables.set('public_profile_id', json.profile.profile_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{user_profile_base_url}}/v1/api/user/profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{profile_name}} Updated\",\n  \"language_preference\": \"{{language_preference}}\"\n}"
            },
            "url": "{{user_profile_base_url}}/v1/api/user/profile"
          }
        },
        {
          "name": "Get Public Profile",
          "request": {
            "method": "GET",
            "url": "{{user_profile_base_url}}/v1/api/user/profile/{{public_profile_id}}"
          }
        },
        {
          "name": "KYC Initiate Aadhar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "if (json && json.transaction_id) pm.collectionVariables.set('kyc_transaction_id', json.transaction_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aadhar_number\": \"{{aadhar_number}}\",\n  \"consent\": true,\n  \"consent_text\": \"I consent to Aadhaar verification\"\n}"
            },
            "url": "{{user_profile_base_url}}/v1/api/kyc/aadhar/initiate"
          }
        },
        {
          "name": "KYC Verify Aadhar OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"{{kyc_transaction_id}}\",\n  \"otp\": \"{{aadhar_otp}}\"\n}"
            },
            "url": "{{user_profile_base_url}}/v1/api/kyc/aadhar/verify"
          }
        },
        {
          "name": "KYC Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{user_profile_base_url}}/v1/api/kyc/status"
          }
        },
        {
          "name": "Delete Profile",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{user_profile_base_url}}/v1/api/user/profile"
          }
        }
      ]
    },
    {
      "name": "3. Seller",
      "item": [
        {
          "name": "Upgrade To Seller",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_name\": \"{{seller_business_name}}\",\n  \"business_type\": \"{{seller_business_type}}\",\n  \"business_category\": \"{{seller_business_category}}\",\n  \"gst_number\": \"{{seller_gst_number}}\",\n  \"pan_number\": \"{{seller_pan_number}}\",\n  \"package_type\": \"{{seller_package_type}}\",\n  \"terms_accepted\": true\n}"
            },
            "url": "{{seller_base_url}}/v1/api/seller/upgrade"
          }
        },
        {
          "name": "Get Seller Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{seller_base_url}}/v1/api/seller/profile"
          }
        },
        {
          "name": "Update Seller Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_name\": \"{{seller_business_name}} Updated\",\n  \"business_category\": \"{{seller_business_category}}\"\n}"
            },
            "url": "{{seller_base_url}}/v1/api/seller/profile"
          }
        }
      ]
    }
  ]
}
