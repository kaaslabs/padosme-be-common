                                                           
  [                                                                                                                                                                                                 
    {rabbit, [                                              
      %% TCP buffer sizes — important for throughput
      {tcp_listen_options, [                                                                                                                                                                        
        {backlog, 128},
        {nodelay, true},                                                                                                                                                                            
        {linger, {true, 0}},                                
        {sndbuf, 32768},                                                                                                                                                                            
        {recbuf, 32768}
      ]},                                                                                                                                                                                           
                                                            
      %% Message store credit flow — prevents fast publishers from                                                                                                                                  
      %% overwhelming slow disk I/O
      {credit_flow_default_credit, {400, 200}}                                                                                                                                                      
    ]},                                                                                                                                                                                             
                                                                                                                                                                                                    
    %% Management plugin — longer-lived stats                                                                                                                                                       
    {rabbitmq_management, [                                 
      {sample_retention_policies, [                                                                                                                                                                 
        {global, [{60, 15}, {600, 60}, {3600, 600}]},       
        {basic,  [{60, 15}, {600, 60}]},                                                                                                                                                            
        {detailed, [{60, 15}]}                                                                                                                                                                      
      ]}                                                                                                                                                                                            
    ]}                                                                                                                                                                                              
  ].                                                                                                                                                                                                
   
